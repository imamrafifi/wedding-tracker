# Copy this file to .env.local for local development.
# In production (Vercel), set these under Project Settings > Environment Variables.

DB_HOST=mysql-xxxxxxxx-yourproject.h.aivencloud.com
DB_PORT=10020
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=defaultdb

# Paste the full contents of ca.pem here, including the
# -----BEGIN CERTIFICATE----- / -----END CERTIFICATE----- lines.
DB_CA_CERT="-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----"
